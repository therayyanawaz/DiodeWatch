# Data, never commit corpora, caches, training logs, or runtime state
# (everything re-derives via scripts/download_baseline_slice.py +
#  scripts/download_ml_corpora.py; runtime artifacts via scripts/check_*.py)
data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Models & artifacts
/models/
/results/

# Offline wheelhouse (~250 MB), built on a networked machine, never committed
# (README §Offline bundle: pip download -r requirements.txt -d setup/wheels)
setup/wheels/

# Node install tree (~200 MB), regenerates with `npm ci` in frontend/.
# The build OUTPUT is committed on purpose (apps/mission_control/static/):
# the offline launch must serve the React wall without Node on the host.
frontend/node_modules/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
memory.md
